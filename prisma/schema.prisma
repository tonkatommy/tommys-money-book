// Tommy's Money Book — Prisma schema
// Data model from the implementation plan §5. Two sets of books (PERSONAL /
// BUSINESS) live in one database; the `book` field on both Account and
// Category is what lets us enforce "never mix personal and business" in code
// rather than by discipline.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Which set of books a record belongs to. Every account and category is
// exactly one or the other — the golden rule of this app.
enum Book {
  PERSONAL
  BUSINESS
}

// What a category fundamentally is. TRANSFER and OWNER exist so that money
// moving between our own accounts (or in/out of the business) is never
// mistaken for income or expenses.
enum Kind {
  INCOME
  EXPENSE
  TRANSFER
  OWNER
}

// The bridge between a freeform category list and the IR3. Categories can be
// renamed/merged freely — as long as these tags are right, year-end tax
// reports don't care what the categories are called.
enum TaxTag {
  RENTAL_INCOME
  RENTAL_EXPENSE
  BIZ_INCOME
  BIZ_EXPENSE
  HOME_OFFICE

  // Personal income that belongs on the IR3 but is neither rental nor
  // business: salary, the W&I benefit, AIA income-protection payments.
  //
  // Added in Phase 2 because the original five tags quietly assumed all
  // personal taxable income was rental income. It isn't — and without this
  // tag $47,555 of AIA payments would be indistinguishable from the
  // genuinely non-taxable receipts (flatmate cost-sharing, gifts, KiwiSaver
  // withdrawals), which would make it the largest thing a year-end report
  // omitted without ever saying so.
  TAXABLE_INCOME
}

// Which field of a transaction a CategoryRule looks at.
//
// The order matters and is deliberate: DESCRIPTION beats MERCHANT beats
// AKAHU_CATEGORY, because that is the order of decreasing specificity in the
// real data. See src/lib/categories/match.ts.
enum RuleField {
  AKAHU_CATEGORY // exact match on Transaction.akahuCategoryName
  MERCHANT // exact match on Transaction.merchantName
  DESCRIPTION // substring match on the *normalised* description
}

// Restricts a rule to money coming in or going out. The sign of amountCents
// is often the only thing separating two meanings of the same payee — a
// refund from a purchase, a loan repaid from a loan made.
enum RuleDirection {
  IN // amountCents > 0
  OUT // amountCents < 0
  ANY
}

// How a transaction came to have its category. The whole point of this enum
// is MANUAL: the matcher must never overwrite a decision a human made, or
// every daily sync would silently undo exactly the corrections that were
// needed — and the books would still look consistent afterwards.
enum CategorySource {
  RULE // assigned by the auto-categorisation matcher
  MANUAL // assigned by a human; the matcher leaves it alone
  TRANSFER // assigned as a side effect of confirming a transfer pair
}

// Where a transaction came from. AKAHU rows carry an externalId for dedupe;
// MANUAL is for cash the bank never sees.
enum Source {
  AKAHU
  MANUAL
}

// Akahu's view of whether it can still talk to the bank. INACTIVE means the
// connection needs re-consent — data goes stale silently unless we shout
// about it, which is exactly the "sync stopped and nobody noticed" failure.
enum AccountStatus {
  ACTIVE
  INACTIVE
}

// What kicked off a sync run. BASELINE is the one-off full-history pull;
// SCHEDULED is the cron worker; MANUAL is a human running the CLI.
enum SyncTrigger {
  BASELINE
  SCHEDULED
  MANUAL
}

// PARTIAL exists because one dead bank connection shouldn't make the whole
// run look like a failure — the other accounts synced fine.
enum SyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

model Account {
  id   String @id @default(cuid())
  name String @unique // "ANZ Everyday", "BNZ Tommy Tinkers", ...

  // Nullable on purpose. A freshly discovered Akahu account genuinely doesn't
  // know which set of books it belongs to yet — pretending it's PERSONAL by
  // default would quietly put business spending in the wrong book. null means
  // "needs mapping", the status page says so, and `npm run accounts:map` fixes
  // it. Phase 3 can put a UI over the same field.
  book Book?

  akahuId String? @unique // Akahu's stable account id, e.g. acc_1111...

  // --- Provenance from Akahu -------------------------------------------------
  // Kept so the status page can show which bank an account came from without
  // re-querying Akahu, and so a renamed account is still recognisable.
  connectionName   String? // "ANZ", "BNZ" — Akahu's connection (bank) name
  akahuName        String? // Akahu's own name for the account
  accountType      String? // CHECKING / SAVINGS / CREDITCARD / ...
  formattedAccount String? // "01-1234-1234567-00"
  currency         String        @default("NZD")
  status           AccountStatus @default(ACTIVE)

  // --- Balance and reconciliation state -------------------------------------
  balanceCents Int? // Akahu-reported current balance, in cents
  balanceAsAt  DateTime? // when Akahu last refreshed that balance

  // Unsettled card authorisations, as Akahu last reported them.
  //
  // Never imported as transactions — pending rows have unstable ids and their
  // amounts change when they settle, which would poison externalId dedupe.
  // Only the total is kept, because the bank's reported balance already
  // includes it and reconciliation has to subtract it back out.
  pendingTotalCents Int @default(0)

  // The balance that existed *before* our earliest imported transaction.
  // Akahu only reaches back ~2 years, so "sum of stored transactions" can
  // never equal the bank balance on its own. We derive this once at baseline
  // (balance - sum of imported) and reconcile against it forever after.
  openingBalanceCents Int?

  // The earliest transaction date Akahu actually returned — this account's
  // day zero. Answers "how far back does each bank's history reach?".
  historyStartDate DateTime? @db.Date

  // High-water mark for incremental pulls: the latest transaction *date* we
  // hold, not the last run time. See src/lib/sync/window.ts for why that
  // distinction matters.
  lastTransactionAt DateTime?

  transactions  Transaction[]
  syncResults   AccountSyncResult[]
  categoryRules CategoryRule[]
}

model Category {
  id     String  @id @default(cuid())
  name   String // final list is built bottom-up from real Akahu data in Phase 2
  book   Book
  kind   Kind
  taxTag TaxTag?

  transactions Transaction[]
  rules        CategoryRule[]

  // Same category name can exist in both books ("Software" personal vs
  // business), but not twice within one book.
  @@unique([name, book])
}

// How a transaction finds its category automatically.
//
// This replaces the `Category.akahuNames String[]` the implementation plan
// specified. Phase 2's discovery report over the real baseline killed the
// assumption behind that design: only 32% of transactions carry an Akahu
// category at all, *none* of the income does (Akahu's enrichment only fires
// on card spending), and an exact list of names cannot express the
// exceptions that decide tax treatment. Two examples that forced the change:
//
//   - "IAG" is three separate policies — motor, home, and landlord — and
//     only the landlord one is a deductible rental expense. They differ by a
//     suffix in the description, not by merchant or category.
//   - "PayPal" is the Shopify subscription on the business account and
//     anything at all on the personal ones.
//
// So Akahu's names became one rule type among three rather than the whole
// mechanism, and rules gained the scoping and precedence needed to say
// "except when...".
model CategoryRule {
  id         String @id @default(cuid())
  categoryId String

  field   RuleField
  pattern String // stored lower-cased; already normalised for DESCRIPTION

  // Optional scope. `accountId` is what lets the same text mean different
  // things in different books; `direction` separates a refund from a spend.
  accountId String?
  direction RuleDirection @default(ANY)

  // Lower numbers win within a tier. Explicit rather than derived from
  // pattern length, so a one-off exception can be forced above a general
  // rule without anyone having to reverse-engineer why it sorts that way.
  priority Int @default(100)

  // Why this rule exists. Six months from now the pattern will be cryptic
  // and the reasoning will be gone; a rule nobody understands is a rule
  // nobody dares change.
  note String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  account  Account? @relation(fields: [accountId], references: [id])

  @@index([field, pattern])
  @@index([categoryId])
}

model Transaction {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  accountId   String
  payee       String?
  description String
  categoryId  String?

  // Money is stored as integer cents — floats can't represent $0.10 exactly
  // and sums drift. -$200.00 is stored as -20000; format at the display edge.
  amountCents Int

  notes  String?
  source Source  @default(AKAHU)

  // --- How the category got there --------------------------------------------
  // Null means uncategorised, which is also what puts a row in the review
  // queue. MANUAL is load-bearing: `categories:apply` skips those rows, so a
  // correction made by hand survives every future rule change and every
  // daily sync. Without it the matcher would re-run over corrected rows and
  // quietly restore the wrong answer.
  categorySource CategorySource?
  categorisedAt  DateTime?

  // Akahu's stable transaction ID. The @unique means a re-run sync can never
  // double-import a transaction — the DB itself refuses.
  externalId String? @unique

  // Links the two legs of a transfer (out ↔ in) as a first-class pair.
  // Unpaired transfers surface as a warning; paired ones net to zero.
  transferPairId String?

  // --- Akahu enrichment, stored raw ------------------------------------------
  // Phase 1 imports uncategorised on purpose: categoryId stays null and these
  // fields hold what Akahu thinks. Phase 2 builds the real category list
  // bottom-up from exactly this data, so it has to survive the import intact.
  merchantName       String?
  akahuCategoryName  String? // "Cafes and restaurants"
  akahuCategoryGroup String? // "Lifestyle" (personal_finance grouping)
  akahuType          String? // EFTPOS / TRANSFER / DIRECT DEBIT / ...
  balanceAfterCents  Int? // running balance Akahu reported after this txn

  // The untouched Akahu payload. Cheap insurance: if Phase 2 needs a field we
  // didn't think to model, it's already here and doesn't need a re-pull
  // (which the 1-hour refresh limit makes expensive). Never contains tokens.
  raw Json?

  importedAt DateTime @default(now())

  account  Account   @relation(fields: [accountId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([date])
  @@index([accountId, date])
  @@index([categoryId])
}

// One row per sync attempt — the audit trail that makes "the sync silently
// stopped" a visible condition rather than a mystery.
model SyncRun {
  id      String      @id @default(cuid())
  trigger SyncTrigger
  status  SyncStatus  @default(RUNNING)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  // Only set for a run-level failure (e.g. Akahu unreachable). Per-account
  // errors live on AccountSyncResult so one bad account doesn't mask the rest.
  error String?

  accounts AccountSyncResult[]

  @@index([startedAt])
}

// Per-account outcome within a run. Storing drift per run (rather than just
// "current drift" on Account) is what lets us tell a transient blip — pending
// transactions settling — from a real, persistent gap in our data.
model AccountSyncResult {
  id        String @id @default(cuid())
  syncRunId String
  accountId String

  fetched    Int @default(0) // transactions Akahu returned
  inserted   Int @default(0) // actually new to us
  duplicates Int @default(0) // fetched - inserted; proof dedupe is working

  windowStart DateTime? // the range we asked Akahu for (start is exclusive)
  windowEnd   DateTime?

  akahuBalanceCents    Int?
  computedBalanceCents Int? // openingBalance + settled + pending
  settledBalanceCents  Int? // openingBalance + settled only — what has cleared
  pendingTotalCents    Int? // unsettled authorisations at the time of this run
  driftCents           Int? // akahu - computed; non-zero = we're missing rows

  error String?

  syncRun SyncRun @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])

  @@unique([syncRunId, accountId])
  @@index([accountId])
}
