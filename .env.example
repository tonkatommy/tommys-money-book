# Copy to .env and fill in. .env is gitignored — never commit real values.

# Used by docker-compose.yml for the Postgres container.
POSTGRES_USER=moneybook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=moneybook

# Used by the app and Prisma when running on the host (npm run dev, migrations).
# Inside Docker the app gets its own DATABASE_URL from docker-compose.yml,
# pointing at host `db` instead of `localhost`.
DATABASE_URL="postgresql://moneybook:change-me@localhost:5432/moneybook"

# --- Akahu ------------------------------------------------------------------
# "fixture" uses the JSON in src/lib/akahu/fixtures/ and makes no network
# calls — the default, so a misconfigured container can't hammer the real API.
# Switch to "live" once the personal app exists at my.akahu.nz.
AKAHU_MODE=fixture

# From my.akahu.nz once you create the personal app. These grant read access to
# every connected bank account, so: never commit them, never paste them into an
# issue, rotate from the Akahu dashboard if you ever doubt one.
# Leave blank while AKAHU_MODE=fixture.
AKAHU_APP_TOKEN=
AKAHU_USER_TOKEN=

# Alternatively, point these at files instead (the Docker secrets convention —
# the value then never appears in the environment or in `docker inspect`):
# AKAHU_APP_TOKEN_FILE=/run/secrets/akahu_app_token
# AKAHU_USER_TOKEN_FILE=/run/secrets/akahu_user_token

# --- Auth ---------------------------------------------------------------
# Single shared password protecting every page (Phase 3a). Behind LAN/
# Tailscale only — see the Phase 3a design spec for why there's no per-user
# login or lockout.
APP_PASSWORD=

# Signs the session cookie (HMAC-SHA256). Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Both also support the Docker-secrets convention, same as the Akahu tokens
# above:
# APP_PASSWORD_FILE=/run/secrets/app_password
# SESSION_SECRET_FILE=/run/secrets/session_secret

# --- Sync worker ------------------------------------------------------------
# 7am NZ daily. node-cron handles the daylight saving shift.
SYNC_CRON=0 7 * * *

# How many days of already-seen transactions each incremental sync re-reads.
# Banks post late — a Monday transaction can appear on Wednesday — so the
# window looks backwards and lets externalId dedupe discard the overlap.
SYNC_LOOKBACK_DAYS=7

# Run one sync immediately on worker startup. Handy when verifying the
# container; leave false in normal operation so restarts don't re-poll Akahu.
SYNC_ON_START=false

# --- Backups ----------------------------------------------------------------
# 2am NZ nightly. Timing barely matters — bank transactions can be re-pulled
# from Akahu if lost. What can't be recovered is the categorisation and the
# confirmed transfer pairs, which is why the backup exists at all.
BACKUP_CRON=0 2 * * *

# Weekly restore test: restores the newest dump into a scratch database,
# counts the rows, drops it. 3:30am Sunday. A backup nobody has restored is a
# hypothesis.
BACKUP_VERIFY_CRON=30 3 * * 0

# Delete dumps older than this — but never go below BACKUP_MIN_KEEP, so a
# container starting up after a long outage can't prune everything it has.
BACKUP_RETAIN_DAYS=30
BACKUP_MIN_KEEP=7

# Take one backup immediately on container start. Useful when verifying the
# setup; leave false in normal operation.
BACKUP_ON_START=false
